# InvestEdge Backend — Environment Variables Example
# Copy this file to .env and fill in your values on the server

GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_optional_second_groq_api_key_here

# Configurable trusted CORS origins (comma-separated list)
# Default includes https://invest-edge-eight.vercel.app, http://localhost:5173, etc.
CORS_ORIGINS=https://invest-edge-eight.vercel.app,http://localhost:5173,http://localhost:3000
